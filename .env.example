# ============================================
# Keyword Key — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values.
# For Vercel deployment, add these in:
#   Project Settings → Environment Variables

# ---- Database (PostgreSQL) ----
# Get a free database from Neon: https://neon.tech
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/keywordkey?sslmode=require

# ---- NextAuth ----
# In production, set this to your Vercel domain (e.g. https://keyword-key.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-your-secure-secret

# ---- Optional: Z.AI SDK ----
# The AI features (content generation, competitor analysis, hashtag tools)
# use the z-ai-web-dev-sdk which requires a .z-ai-config file.
# If not configured, the app automatically falls back to mock data.
# No environment variable needed — the SDK reads from .z-ai-config.

# ---- Optional: RapidAPI Key (for REAL social media account data) ----
# The "Social Integration" feature connects to TikTok/YouTube/Instagram
# and fetches REAL account stats (followers, posts, engagement).
# TikTok's public pages no longer embed user data in HTML, so we use
# a third-party scraper API hosted on RapidAPI.
#
# Get a FREE key:
#   1. Sign up at https://rapidapi.com (free)
#   2. Search for "TikTok Scraper" or "TikTok API"
#   3. Subscribe to a free plan (e.g. tiktok-scraper7, tiktok-api15)
#   4. Copy your API key from the app's "X-RapidAPI-Key" header
#   5. Paste it below
#
# Without this key, the integration will show AI-estimated data
# (clearly labelled as "تقديري" / estimated) instead of real stats.
RAPIDAPI_KEY=
